program project1;

{$mode objfpc}{$H+}

uses
  JS, Web;

// Helper procedure to create an element with a class name
function CreateElementWithClass(tag, className: string): TJSElement;
begin
  Result := document.createElement(tag);
  Result.className := className;
end;

// Smooth scroll procedure
procedure SmoothScroll(targetId: string);
var
  targetElement: TJSHTMLElement;  // Changed from TJSElement
begin
  if targetId = '' then Exit;

  targetElement := TJSHTMLElement(document.getElementById(targetId));
  if Assigned(targetElement) then
  begin
    targetElement.scrollIntoView;
  end;
end;

// Event handler wrappers
procedure OnHomeClick(e: TJSMouseEvent);
begin
  SmoothScroll('home');
  e.preventDefault;
end;

procedure OnAboutClick(e: TJSMouseEvent);
begin
  SmoothScroll('about');
  e.preventDefault;
end;

procedure OnContactClick(e: TJSMouseEvent);
begin
  SmoothScroll('contact');
  e.preventDefault;
end;

procedure OnContactBtnClick(e: TJSMouseEvent);
begin
  SmoothScroll('contact');
  e.preventDefault;
end;

// Main procedure to build the entire page
procedure BuildWebsite;
var
  header, nav, navContainer, main, footer: TJSElement;
  navLinks: TJSElement;
  homeLink, aboutLink, contactLink: TJSElement;
  homeSection, aboutSection, contactSection: TJSElement;
  homeDiv, homeH1, homeP, homeButton: TJSElement;
  aboutDiv, aboutH2, aboutP, aboutMissionDiv, missionH3, missionP: TJSElement;
  contactDiv, contactH2, contactForm, nameInput, emailInput, messageInput, submitBtn: TJSElement;
  style: TJSElement;
  yearSpan: TJSElement;
begin
  // --- Create Header ---
  header := CreateElementWithClass('header', 'site-header');
  nav := document.createElement('nav');
  navContainer := CreateElementWithClass('div', 'nav-container');

  // Create navigation links
  navLinks := document.createElement('div');
  navLinks.className := 'nav-links';

  homeLink := document.createElement('a');
  homeLink.textContent := 'HOME';
  homeLink.addEventListener('click', @OnHomeClick);
  navLinks.appendChild(homeLink);

  aboutLink := document.createElement('a');
  aboutLink.textContent := 'ABOUT';
  aboutLink.addEventListener('click', @OnAboutClick);
  navLinks.appendChild(aboutLink);

  contactLink := document.createElement('a');
  contactLink.textContent := 'CONTACT';
  contactLink.addEventListener('click', @OnContactClick);
  navLinks.appendChild(contactLink);

  navContainer.appendChild(navLinks);
  nav.appendChild(navContainer);
  header.appendChild(nav);
  document.body.appendChild(header);

  // --- Section 1: Home (Hero) ---
  homeSection := document.createElement('section');
  homeSection.id := 'home';
  homeSection.className := 'hero-section';

  homeDiv := CreateElementWithClass('div', 'hero-content');
  homeH1 := document.createElement('h1');
  homeH1.innerHTML := 'Building Relationships for <span class="highlight">SUSTAINABLE GROWTH</span>';
  homeP := document.createElement('p');
  homeP.textContent := 'Rushikes & Co. is engaged in providing chartered accounting services, financial and consultancy services, internal auditing, and corporate services.';
  homeButton := document.createElement('a');
  homeButton.className := 'btn-primary';
  homeButton.textContent := 'Get in Touch';
  homeButton.addEventListener('click', @OnContactBtnClick);

  homeDiv.appendChild(homeH1);
  homeDiv.appendChild(homeP);
  homeDiv.appendChild(homeButton);
  homeSection.appendChild(homeDiv);

  // --- Section 2: About ---
  aboutSection := document.createElement('section');
  aboutSection.id := 'about';
  aboutSection.className := 'about-section';

  aboutDiv := CreateElementWithClass('div', 'container');
  aboutH2 := document.createElement('h2');
  aboutH2.textContent := 'About Us';
  aboutP := document.createElement('p');
  aboutP.textContent := 'Rushikes & Co. firm is formed by 4 professionals who have diverse experience in their respective areas of practice. Our objective is to enhance the prospects of our clients.';

  aboutMissionDiv := CreateElementWithClass('div', 'mission-box');
  missionH3 := document.createElement('h3');
  missionH3.textContent := 'Our Mission';
  missionP := document.createElement('p');
  missionP.textContent := 'To provide "One Stop Solutions" to our clients, combining technical expertise with personalized service.';

  aboutMissionDiv.appendChild(missionH3);
  aboutMissionDiv.appendChild(missionP);

  aboutDiv.appendChild(aboutH2);
  aboutDiv.appendChild(aboutP);
  aboutDiv.appendChild(aboutMissionDiv);
  aboutSection.appendChild(aboutDiv);

  // --- Section 3: Contact ---
  contactSection := document.createElement('section');
  contactSection.id := 'contact';
  contactSection.className := 'contact-section';

  contactDiv := CreateElementWithClass('div', 'container');
  contactH2 := document.createElement('h2');
  contactH2.textContent := 'Contact Us';

  contactForm := document.createElement('form');
  contactForm.id := 'contact-form';

  nameInput := document.createElement('input');
  nameInput.setAttribute('placeholder', 'Your Name');
  nameInput.setAttribute('required', 'required');

  emailInput := document.createElement('input');
  emailInput.setAttribute('type', 'email');
  emailInput.setAttribute('placeholder', 'Your Email');
  emailInput.setAttribute('required', 'required');

  messageInput := document.createElement('textarea');
  messageInput.setAttribute('placeholder', 'Your Message');
  messageInput.setAttribute('rows', '5');
  messageInput.setAttribute('required', 'required');

  submitBtn := document.createElement('button');
  submitBtn.setAttribute('type', 'submit');
  submitBtn.textContent := 'Send Message';
  submitBtn.className := 'btn-primary';

  contactForm.appendChild(nameInput);
  contactForm.appendChild(emailInput);
  contactForm.appendChild(messageInput);
  contactForm.appendChild(submitBtn);

  contactDiv.appendChild(contactH2);
  contactDiv.appendChild(contactForm);
  contactSection.appendChild(contactDiv);

  // Add all sections to main
  main := document.createElement('main');
  main.appendChild(homeSection);
  main.appendChild(aboutSection);
  main.appendChild(contactSection);
  document.body.appendChild(main);

  // --- Create Footer ---
  footer := document.createElement('footer');
  footer.className := 'site-footer';
  yearSpan := document.createElement('span');
  yearSpan.innerHTML := '© 2025 Rushikes & Co. All rights reserved.';
  footer.appendChild(yearSpan);
  document.body.appendChild(footer);

  // --- Add CSS styles ---
  style := document.createElement('style');
  style.textContent :=
    '* { margin: 0; padding: 0; box-sizing: border-box; } ' +
    'body { font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; } ' +
    '.site-header { background: #1a2a3a; position: fixed; width: 100%; top: 0; z-index: 1000; } ' +
    '.nav-container { max-width: 1200px; margin: 0 auto; padding: 1rem; text-align: center; } ' +
    '.nav-links a { color: white; text-decoration: none; margin: 0 15px; font-weight: 500; transition: color 0.3s; cursor: pointer; } ' +
    '.nav-links a:hover { color: #ffd700; } ' +
    'section { padding: 80px 20px; min-height: 100vh; display: flex; align-items: center; } ' +
    '.hero-section { background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); text-align: center; } ' +
    '.hero-content { max-width: 800px; margin: 0 auto; } ' +
    '.hero-content h1 { font-size: 3rem; margin-bottom: 1rem; color: #1a2a3a; } ' +
    '.highlight { color: #c0392b; } ' +
    '.hero-content p { font-size: 1.2rem; margin-bottom: 2rem; } ' +
    '.btn-primary { display: inline-block; background: #c0392b; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px; transition: background 0.3s; border: none; cursor: pointer; font-size: 1rem; } ' +
    '.btn-primary:hover { background: #a93226; } ' +
    '.about-section { background: white; } ' +
    '.container { max-width: 1200px; margin: 0 auto; text-align: center; } ' +
    '.about-section h2, .contact-section h2 { font-size: 2.5rem; margin-bottom: 2rem; color: #1a2a3a; } ' +
    '.about-section p { font-size: 1.1rem; margin-bottom: 2rem; max-width: 800px; margin-left: auto; margin-right: auto; } ' +
    '.mission-box { background: #f8f9fa; padding: 2rem; border-radius: 8px; max-width: 600px; margin: 2rem auto; } ' +
    '.contact-section { background: #f5f7fa; } ' +
    '.contact-section form { max-width: 600px; margin: 0 auto; } ' +
    '.contact-section input, .contact-section textarea { width: 100%; padding: 12px; margin-bottom: 1rem; border: 1px solid #ddd; border-radius: 5px; } ' +
    '.site-footer { background: #1a2a3a; color: white; text-align: center; padding: 1.5rem; position: relative; bottom: 0; width: 100%; } ' +
    '@media (max-width: 768px) { .hero-content h1 { font-size: 2rem; } section { padding: 60px 20px; } } ';
  document.head.appendChild(style);
end;

begin
  BuildWebsite;
end.
